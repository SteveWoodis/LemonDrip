# flyctl launch added from backend\.gitignore
# Environment files
backend\**\.env
backend\**\.env.*
backend\**\*.env
backend\**\backend\.env
backend\**\backend\.env*
backend\**\backend\env
backend\**\backend\env.*
backend\**\backend\*.env*
backend\**\backend\*.db
# Node
backend\**\node_modules
backend\**\backend\node_modules
backend\**\pwa_frontend\node_modules
# Logs
