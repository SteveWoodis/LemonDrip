import { useState } from "react";

// --- Main Layout ---
export default function AppLayout() {
  const [active, setActive] = useState("Dashboard");

  const renderContent = () => {
    switch (active) {
      case "Dashboard": return <Dashboard />;
      case "SalesEntry": return <SalesEntry />;
      case "EmployeeManager": return <EmployeeManager />;
      case "FeeTracker": return <FeeTracker />;
      case "Reports": return <Reports />;
      default: return <Dashboard />;
    }
  };

  return (
    <div className="flex h-screen bg-gray-50">
      {/* Sidebar */}
      <div className="w-64 bg-white shadow-lg flex flex-col">
        <h1 className="text-2xl font-bold p-4 border-b">Event Calculator</h1>
        <nav className="flex-1 p-2">
          {["Dashboard", "SalesEntry", "EmployeeManager", "FeeTracker", "Reports"].map((item) => (
            <button
              key={item}
              onClick={() => setActive(item)}
              className={`w-full text-left p-2 rounded-lg mb-1 transition ${
                active === item ? "bg-blue-500 text-white" : "hover:bg-gray-200"
              }`}
            >
              {item.replace(/([A-Z])/g, ' $1').trim()}
            </button>
          ))}
        </nav>
      </div>

      {/* Main Content */}
      <div className="flex-1 overflow-auto p-6">
        {renderContent()}
      </div>
    </div>
  );
}

